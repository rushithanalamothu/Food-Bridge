# Copy to .env at the repository root. These credentials are LOCAL ONLY.
FOODBRIDGE_ENVIRONMENT=local
FOODBRIDGE_DATABASE_URL=postgresql+psycopg://foodbridge:foodbridge_local@localhost:5432/foodbridge
FOODBRIDGE_REDIS_URL=redis://localhost:6379/0
FOODBRIDGE_CORS_ORIGINS=["http://localhost:5173"]
# Intake identity/provider settings are below; the local demo is opt-in.
# Future provider secrets belong here, never in VITE_* or committed files.

# Optional host port overrides if another local project uses the defaults.
FOODBRIDGE_DB_PORT=5432
FOODBRIDGE_REDIS_PORT=6379

# Intake demo: explicit LOCAL ONLY opt-in, followed by make seed-intake-demo.
FOODBRIDGE_ENABLE_LOCAL_INTAKE_DEMO=false
# Local-only process metrics at /api/v1/metrics (no donor text or IDs in labels).
FOODBRIDGE_ENABLE_INTAKE_METRICS=false
# auto: no key -> rules; one provider key -> that provider; multiple -> choose explicitly.
FOODBRIDGE_AI_PROVIDER=auto
# One shared provider/key/model for ALL AI features (API and workers).
# Set ONE server-only provider key (API keys, not ChatGPT/Claude subscription logins).
# OPENAI_API_KEY=<your OpenAI API key>
# GEMINI_API_KEY=<your Google AI Studio API key>
# ANTHROPIC_API_KEY=<your Anthropic API key>
# GOOGLE_API_KEY is also accepted for Gemini. FOODBRIDGE_<PROVIDER>_API_KEY aliases work.
# Optional overrides (provider: openai | gemini | anthropic | rules | openai_compatible).
# FOODBRIDGE_AI_MODEL=<structured-output-capable-model>
# FOODBRIDGE_AI_API_KEY=<key for the explicitly selected provider>
# FOODBRIDGE_AI_TIMEOUT_S=8
# Other OpenAI-compatible services: select openai_compatible and set key, model, HTTPS base.
# FOODBRIDGE_AI_BASE_URL=https://your-provider.example/v1
# FOODBRIDGE_AI_RESPONSE_FORMAT=json_schema
# Use json_object only for compatible endpoints without JSON Schema support.
# Shared environments verify RS256 JWTs and server-managed donor memberships.
# FOODBRIDGE_OIDC_ISSUER=https://your-identity-provider/
# FOODBRIDGE_OIDC_AUDIENCE=foodbridge-api
# FOODBRIDGE_OIDC_JWKS_URL=https://your-identity-provider/.well-known/jwks.json
