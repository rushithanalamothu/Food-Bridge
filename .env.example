# Copy to .env at the repository root. These credentials are LOCAL ONLY.
FOODBRIDGE_ENVIRONMENT=local
FOODBRIDGE_DATABASE_URL=postgresql+psycopg://foodbridge:foodbridge_local@localhost:5432/foodbridge
FOODBRIDGE_REDIS_URL=redis://localhost:6379/0
FOODBRIDGE_CORS_ORIGINS=["http://localhost:5173"]
# Business integrations and authentication are not implemented in the scaffold.
# Future provider secrets belong here, never in VITE_* or committed files.

# Optional host port overrides if another local project uses the defaults.
FOODBRIDGE_DB_PORT=5432
FOODBRIDGE_REDIS_PORT=6379
