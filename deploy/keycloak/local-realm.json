{
  "realm": "foodbridge",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "clients": [
    {
      "clientId": "foodbridge-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:55173/api/v1/auth/callback"],
      "webOrigins": ["http://localhost:55173"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "foodbridge-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "tej-demo",
      "enabled": true,
      "firstName": "Synthetic",
      "lastName": "Operator",
      "email": "tej@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "foodbridge-local-only",
          "temporary": false
        }
      ]
    }
  ],
  "loginTheme": "foodbridge-local",
  "displayName": "FoodBridge",
  "displayNameHtml": "food<span>bridge</span><sup>\u25cf</sup>",
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "registrationEmailAsUsername": false,
  "editUsernameAllowed": false,
  "passwordPolicy": "length(12)",
  "actionTokenGeneratedByUserLifespan": 900,
  "accessCodeLifespanLogin": 1800,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "accounts@example.test",
    "fromDisplayName": "FoodBridge",
    "auth": "false",
    "starttls": "false",
    "ssl": "false"
  }
