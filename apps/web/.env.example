# Public SPA configuration only. Never put provider secrets or access tokens here.
# Copy to apps/web/.env.local and register an Authorization Code + PKCE public client.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile
# Optional access-token audience requested from providers that support this parameter.
VITE_OIDC_AUDIENCE=
# Callback: http://localhost:5173/auth/callback (use your actual HTTPS origin when hosted).
