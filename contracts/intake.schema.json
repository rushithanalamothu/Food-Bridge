          "type": "boolean"
        },
        "donation": {
          "$ref": "#/$defs/DonationInput"
        },
        "draft_id": {
          "format": "uuid",
          "title": "Draft Id",
          "type": "string"
        },
        "expected_draft_version": {
          "minimum": 1,
          "title": "Expected Draft Version",
          "type": "integer"
        }
      },
      "required": [
        "draft_id",
        "expected_draft_version",
        "confirmed",
        "donation"
      ],
      "title": "DonationSubmit",
      "type": "object"
    },
    "DonorIdentity": {
      "additionalProperties": false,
