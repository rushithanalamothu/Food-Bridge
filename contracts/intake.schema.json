{
  "$defs": {
    "DonationInput": {
      "additionalProperties": false,
      "description": "Donor-confirmed data, not unreviewed LLM extraction.",
      "properties": {
        "allergens": {
          "description": "Explicitly confirmed; [] means none declared.",
          "items": {
            "type": "string"
          },
          "title": "Allergens",
          "type": "array"
        },
        "category": {
          "enum": [
            "prepared_meals",
            "produce",
            "bakery",
            "dairy",
            "pantry",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "dietary_tags": {
          "items": {
            "type": "string"
          },
          "title": "Dietary Tags",
          "type": "array"
        },
        "food_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Food Name",
          "type": "string"
        },
        "handling_notes": {
          "default": "",
          "maxLength": 1000,
          "title": "Handling Notes",
          "type": "string"
        },
        "pickup_location": {
          "$ref": "#/$defs/Location"
        },
        "pickup_window": {
          "$ref": "#/$defs/PickupWindow"
        },
        "portions": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Portions"
        },
        "quantity_kg": {
          "exclusiveMinimum": 0,
          "title": "Quantity Kg",
          "type": "number"
        },
        "safe_use_by": {
          "format": "date-time",
          "title": "Safe Use By",
          "type": "string"
        },
        "storage": {
          "enum": [
            "ambient",
            "chilled",
            "frozen"
          ],
          "title": "Storage",
          "type": "string"
        }
      },
      "required": [
        "description",
        "food_name",
        "category",
        "quantity_kg",
        "storage",
        "allergens",
        "pickup_location",
        "pickup_window",
        "safe_use_by"
      ],
      "title": "DonationInput",
      "type": "object"
    },
    "DonationPage": {
      "additionalProperties": false,
