        "pickup_window": {
          "$ref": "#/$defs/PickupWindow"
        },
        "portions": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Portions"
        },
        "quantity_kg": {
          "exclusiveMinimum": 0,
          "title": "Quantity Kg",
          "type": "number"
