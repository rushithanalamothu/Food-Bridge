        "safe_use_by",
        "id",
        "donor_organization_id",
        "status",
        "version",
        "created_at"
      ],
      "title": "DonationRead",
      "type": "object"
    },
    "DonationStatus": {
      "enum": [
        "draft",
        "submitted",
        "needs_review",
        "matching",
        "offered",
        "reserved",
        "pickup_assigned",
        "picked_up",
        "delivered",
        "no_match",
        "expired",
        "cancelled",
        "failed"
      ],
      "title": "DonationStatus",
      "type": "string"
    },
    "DonationSubmit": {
      "additionalProperties": false,
      "properties": {
        "confirmed": {
          "const": true,
