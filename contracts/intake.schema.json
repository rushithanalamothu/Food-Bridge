        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "mode": {
          "enum": [
            "local_demo",
            "oidc"
          ],
          "title": "Mode",
          "type": "string"
        },
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
