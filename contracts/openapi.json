        "type": "object"
      },
      "ReadyStatus": {
        "properties": {
          "dependencies": {
            "additionalProperties": {
              "enum": [
                "ok",
                "unavailable"
              ],
              "type": "string"
            },
            "title": "Dependencies",
            "type": "object"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "dependencies"
        ],
        "title": "ReadyStatus",
        "type": "object"
      },
      "ReviewIssue": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "missing",
              "uncertain",
              "provider_unavailable",
              "source_mismatch"
            ],
            "title": "Code",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "ReviewIssue",
        "type": "object"
      },
      "UrgencyAssessment": {
        "additionalProperties": false,
        "properties": {
          "basis": {
            "const": "confirmed_deadline",
            "default": "confirmed_deadline",
            "title": "Basis",
            "type": "string"
          },
          "deadline_at": {
            "format": "date-time",
            "title": "Deadline At",
            "type": "string"
          },
          "policy_version": {
            "default": "eligibility-v2",
            "title": "Policy Version",
            "type": "string"
          },
          "priority": {
            "enum": [
              "normal",
              "high",
              "critical",
              "expired"
            ],
            "title": "Priority",
            "type": "string"
          },
          "score": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "type": "number"
          },
          "seconds_remaining": {
            "title": "Seconds Remaining",
            "type": "number"
          }
        },
        "required": [
          "priority",
          "deadline_at",
          "seconds_remaining",
          "score"
        ],
        "title": "UrgencyAssessment",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
