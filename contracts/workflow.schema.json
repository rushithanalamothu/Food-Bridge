{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "donor",
            "recipient",
            "driver",
            "operator"
          ],
          "title": "Role",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "organization_id",
        "role"
      ],
      "title": "Actor",
      "type": "object"
    },
    "DeliveryConfirmation": {
      "additionalProperties": false,
      "properties": {
        "delivery_confirmed": {
          "const": true,
          "title": "Delivery Confirmed",
          "type": "boolean"
        },
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "expected_version",
        "delivery_confirmed"
      ],
      "title": "DeliveryConfirmation",
      "type": "object"
    },
    "DonationCommand": {
      "additionalProperties": false,
      "properties": {
        "expected_donation_version": {
          "minimum": 1,
          "title": "Expected Donation Version",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "expected_donation_version"
      ],
      "title": "DonationCommand",
      "type": "object"
    },
    "DonationRead": {
      "additionalProperties": false,
      "properties": {
        "allergens": {
          "description": "Explicitly confirmed; [] means none declared.",
          "items": {
            "type": "string"
          },
          "title": "Allergens",
          "type": "array"
        },
        "category": {
          "enum": [
            "prepared_meals",
            "produce",
            "bakery",
            "dairy",
            "pantry",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "dietary_tags": {
          "items": {
            "type": "string"
          },
          "title": "Dietary Tags",
          "type": "array"
        },
        "donor_organization_id": {
          "format": "uuid",
          "title": "Donor Organization Id",
          "type": "string"
        },
        "food_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Food Name",
          "type": "string"
        },
        "handling_notes": {
          "default": "",
          "maxLength": 1000,
          "title": "Handling Notes",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "packaging_type": {
          "anyOf": [
            {
              "enum": [
                "boxed",
                "sealed",
                "bulk",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Packaging Type"
        },
        "pickup_location": {
          "$ref": "#/$defs/Location"
        },
        "pickup_window": {
          "$ref": "#/$defs/PickupWindow"
        },
        "portions": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Portions"
        },
        "quantity_kg": {
          "exclusiveMinimum": 0,
          "title": "Quantity Kg",
          "type": "number"
        },
        "safe_use_by": {
          "format": "date-time",
          "title": "Safe Use By",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DonationStatus"
        },
        "storage": {
          "enum": [
            "ambient",
            "chilled",
            "frozen"
          ],
          "title": "Storage",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "description",
        "food_name",
        "category",
        "quantity_kg",
        "storage",
        "allergens",
        "pickup_location",
        "pickup_window",
        "safe_use_by",
        "id",
        "donor_organization_id",
        "status",
        "version",
        "created_at"
      ],
      "title": "DonationRead",
      "type": "object"
    },
    "DonationStatus": {
      "enum": [
        "draft",
        "submitted",
        "needs_review",
        "matching",
        "offered",
        "reserved",
        "pickup_assigned",
        "picked_up",
        "delivered",
        "no_match",
        "expired",
        "cancelled",
        "failed"
      ],
      "title": "DonationStatus",
      "type": "string"
    },
    "EventEnvelope": {
      "additionalProperties": false,
      "description": "Queue metadata; payloads are IDs, never raw donor text or unrestricted PII.",
      "properties": {
        "aggregate_id": {
          "format": "uuid",
          "title": "Aggregate Id",
          "type": "string"
        },
        "aggregate_version": {
          "minimum": 1,
          "title": "Aggregate Version",
          "type": "integer"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "pattern": "^[a-z_]+\\.[a-z_]+\\.v1$",
          "title": "Event Type",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "payload": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Payload",
          "type": "object"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "event_type",
        "aggregate_id",
        "aggregate_version",
        "correlation_id",
        "occurred_at",
        "payload"
      ],
      "title": "EventEnvelope",
      "type": "object"
    },
    "FailurePage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/FailureRead"
          },
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        }
      },
      "required": [
        "items"
      ],
      "title": "FailurePage",
      "type": "object"
    },
    "FailureRead": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "title": "Attempts",
          "type": "integer"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "donation_id": {
          "format": "uuid",
          "title": "Donation Id",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "replay_count": {
          "title": "Replay Count",
          "type": "integer"
        },
        "step_id": {
          "format": "uuid",
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "donation_id",
        "step_id",
        "code",
        "attempts",
        "created_at",
        "replay_count"
      ],
      "title": "FailureRead",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Address",
          "type": "string"
        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "timezone": {
          "default": "America/Los_Angeles",
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "address",
        "latitude",
        "longitude"
      ],
      "title": "Location",
      "type": "object"
    },
    "MatchRecommendation": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "enum": [
            "distance_only",
            "multi_criteria"
          ],
          "title": "Algorithm",
          "type": "string"
        },
        "distance_m": {
          "minimum": 0,
          "title": "Distance M",
          "type": "number"
        },
        "donation_id": {
          "format": "uuid",
          "title": "Donation Id",
          "type": "string"
        },
        "donation_version": {
          "minimum": 1,
          "title": "Donation Version",
          "type": "integer"
        },
        "eligibility_policy_version": {
          "minLength": 1,
          "title": "Eligibility Policy Version",
          "type": "string"
        },
        "explanation": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "matching_round": {
          "minimum": 1,
          "title": "Matching Round",
          "type": "integer"
        },
        "offer_expires_at": {
          "format": "date-time",
          "title": "Offer Expires At",
          "type": "string"
        },
        "ranking_config_version": {
          "minLength": 1,
          "title": "Ranking Config Version",
          "type": "string"
        },
        "recipient_organization_id": {
          "format": "uuid",
          "title": "Recipient Organization Id",
          "type": "string"
        },
        "travel_time_s": {
          "minimum": 0,
          "title": "Travel Time S",
          "type": "number"
        }
      },
      "required": [
        "id",
        "donation_id",
        "recipient_organization_id",
        "matching_round",
        "donation_version",
        "distance_m",
        "travel_time_s",
        "offer_expires_at",
        "explanation",
        "algorithm",
        "eligibility_policy_version",
        "ranking_config_version"
      ],
      "title": "MatchRecommendation",
      "type": "object"
    },
    "OfferPage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/OfferRead"
          },
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        }
      },
      "required": [
        "items"
      ],
      "title": "OfferPage",
      "type": "object"
    },
    "OfferRead": {
      "additionalProperties": false,
      "properties": {
        "recommendation": {
          "$ref": "#/$defs/MatchRecommendation"
        },
        "status": {
          "enum": [
            "offered",
            "accepted",
            "declined",
            "expired",
            "superseded"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "recommendation",
        "status",
        "version"
      ],
      "title": "OfferRead",
      "type": "object"
    },
    "OperationsSummary": {
      "additionalProperties": false,
      "properties": {
        "counts_by_status": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts By Status",
          "type": "object"
        },
        "delivered_count": {
          "title": "Delivered Count",
          "type": "integer"
        },
        "delivered_kg": {
          "title": "Delivered Kg",
          "type": "number"
        },
        "notification_counts_by_status": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Notification Counts By Status",
          "type": "object"
        },
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "organization_id",
        "counts_by_status",
        "delivered_kg",
        "delivered_count",
        "synthetic"
      ],
      "title": "OperationsSummary",
      "type": "object"
    },
    "PickupConfirmation": {
      "additionalProperties": false,
      "properties": {
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        },
        "handling_confirmed": {
          "const": true,
          "title": "Handling Confirmed",
          "type": "boolean"
        },
        "observed_quantity_kg": {
          "exclusiveMinimum": 0,
          "title": "Observed Quantity Kg",
          "type": "number"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "expected_version",
        "handling_confirmed",
        "observed_quantity_kg"
      ],
      "title": "PickupConfirmation",
      "type": "object"
    },
    "PickupPage": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/PickupRead"
          },
          "title": "Items",
          "type": "array"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        }
      },
      "required": [
        "items"
      ],
      "title": "PickupPage",
      "type": "object"
    },
    "PickupRead": {
      "additionalProperties": false,
      "properties": {
        "donation": {
          "$ref": "#/$defs/DonationRead"
        },
        "donation_id": {
          "format": "uuid",
          "title": "Donation Id",
          "type": "string"
        },
        "driver_id": {
          "format": "uuid",
          "title": "Driver Id",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "reservation_id": {
          "format": "uuid",
          "title": "Reservation Id",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "status": {
          "enum": [
            "assigned",
            "accepted",
            "declined",
            "collected",
            "delivered",
            "released",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "donation_id",
        "reservation_id",
        "driver_id",
        "status",
        "version",
        "start",
        "end",
        "donation"
      ],
      "title": "PickupRead",
      "type": "object"
    },
    "PickupWindow": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "PickupWindow",
      "type": "object"
    },
    "ReplayResult": {
      "additionalProperties": false,
      "properties": {
        "failure_id": {
          "format": "uuid",
          "title": "Failure Id",
          "type": "string"
        },
        "status": {
          "const": "queued",
          "default": "queued",
          "title": "Status",
          "type": "string"
        },
        "step_id": {
          "format": "uuid",
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "failure_id",
        "step_id"
      ],
      "title": "ReplayResult",
      "type": "object"
    },
    "ReservationRead": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "donation_id": {
          "format": "uuid",
          "title": "Donation Id",
          "type": "string"
        },
        "donation_version": {
          "title": "Donation Version",
          "type": "integer"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "match_id": {
          "format": "uuid",
          "title": "Match Id",
          "type": "string"
        },
        "quantity_kg": {
          "title": "Quantity Kg",
          "type": "number"
        },
        "recipient_organization_id": {
          "format": "uuid",
          "title": "Recipient Organization Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "released",
            "completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "storage": {
          "title": "Storage",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "donation_id",
        "match_id",
        "recipient_organization_id",
        "quantity_kg",
        "storage",
        "status",
        "version",
        "donation_version",
        "created_at"
      ],
      "title": "ReservationRead",
      "type": "object"
    },
    "StreamItem": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "$ref": "#/$defs/EventEnvelope"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "event"
      ],
      "title": "StreamItem",
      "type": "object"
    },
    "VersionCommand": {
      "additionalProperties": false,
      "properties": {
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "expected_version"
      ],
      "title": "VersionCommand",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "delivery_confirmation": {
      "$ref": "#/$defs/DeliveryConfirmation"
    },
    "donation_command": {
      "$ref": "#/$defs/DonationCommand"
    },
    "failure": {
      "$ref": "#/$defs/FailureRead"
    },
    "failures": {
      "$ref": "#/$defs/FailurePage"
    },
    "offer": {
      "$ref": "#/$defs/OfferRead"
    },
    "offers": {
      "$ref": "#/$defs/OfferPage"
    },
    "pickup": {
      "$ref": "#/$defs/PickupRead"
    },
    "pickup_confirmation": {
      "$ref": "#/$defs/PickupConfirmation"
    },
    "pickups": {
      "$ref": "#/$defs/PickupPage"
    },
    "replay": {
      "$ref": "#/$defs/ReplayResult"
    },
    "reservation": {
      "$ref": "#/$defs/ReservationRead"
    },
    "stream_item": {
      "$ref": "#/$defs/StreamItem"
    },
    "summary": {
      "$ref": "#/$defs/OperationsSummary"
    },
    "version_command": {
      "$ref": "#/$defs/VersionCommand"
    }
  },
  "required": [
    "actor",
    "version_command",
    "donation_command",
    "pickup_confirmation",
    "delivery_confirmation",
    "reservation",
    "pickup",
    "pickups",
    "offer",
    "offers",
    "failure",
    "failures",
    "replay",
    "summary",
    "stream_item"
  ],
  "title": "WorkflowContracts",
  "type": "object"
}
